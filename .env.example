# Copy to .env only if you prefer environment variables to macOS Keychain.
# Never commit real credentials.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Optional alternative to entering a DEV key in Channels (macOS Keychain).
DEVTO_API_KEY=

# Optional local data location. Defaults to ~/.distribution-os.
DISTRIBUTION_OS_DATA_DIR=
# Optional local service port. Defaults to 4191.
DISTRIBUTION_OS_PORT=4191
