{
  "name": "distribution-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first distribution harness for technical products.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n service,ui -c cyan,blue \"npm:dev:service\" \"npm:dev:ui\"",
    "dev:service": "node --watch --no-warnings --experimental-strip-types server/index.ts",
    "dev:ui": "vite",
    "dev:marketing": "vite --config vite.marketing.config.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json",
    "typecheck:marketing": "vue-tsc --noEmit -p tsconfig.marketing.json",
    "build": "npm run typecheck && tsc -p tsconfig.server.json && vite build",
    "build:marketing": "npm run typecheck:marketing && vite build --config vite.marketing.config.ts",
    "start": "node --no-warnings dist-server/server/index.js",
    "test": "node --no-warnings --experimental-strip-types --test test/*.test.ts",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.42",
    "@ai-sdk/google": "^4.0.51",
    "@ai-sdk/openai": "^4.0.47",
    "@ai-sdk/openai-compatible": "^3.0.37",
    "@modelcontextprotocol/client": "^2.0.0",
    "ai": "^7.0.79",
    "mammoth": "^1.10.0",
    "osx-components": "^0.7.0",
    "pdf-parse": "^1.1.1",
    "vue": "^3.5.21",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/node": "^24.10.0",
    "@types/pdf-parse": "^1.1.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.3",
    "vue-tsc": "^3.0.8"
  }
}
