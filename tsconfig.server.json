{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist-server",
    "rewriteRelativeImportExtensions": true,
    "sourceMap": true
  },
  "include": ["server/**/*.ts", "packages/action-fabric/src/**/*.ts"]
}
